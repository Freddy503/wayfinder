# Model provider. The default model is openrouter:deepseek/deepseek-v4-flash,
# so this is the only key the planner needs. https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Only needed if you point --model at anthropic:... directly.
ANTHROPIC_API_KEY=sk-ant-...

# Speech-to-speech intake. The browser never sees this key: the server mints a
# short-lived client secret from it. Without it, voice intake is disabled and
# the typed fallback still works.
OPENAI_API_KEY=sk-proj-...

# GPT-Live-1 and GPT-Live-1 mini are not in the API yet (ChatGPT-only since
# 8 July 2026, developer access waitlisted). Set this to gpt-live-1 the day it
# opens up — nothing else needs to change.
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin

# LangSmith — tracing + evaluation
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=wayfinder

# Web search (Tavily). Optional: omit to fall back to the offline stub.
TAVILY_API_KEY=tvly-...

# Nominatim requires a descriptive User-Agent identifying the application
# and a contact address. Be a good citizen: <=1 req/s, cache everything.
WAYFINDER_USER_AGENT=wayfinder/0.1 (you@example.com)

# RouteStack — live flight inventory over MCP. Optional: without a key,
# flight_search falls back to indicative fares parsed from public pages.
# https://www.routestack.ai
ROUTESTACK_MCP_URL=https://mcp.routestack.ai/mcp
ROUTESTACK_API_KEY=rst_...
ROUTESTACK_API_SECRET=
ROUTESTACK_ACCOUNT_ID=
